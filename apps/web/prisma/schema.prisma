datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Used for secure direct migrations
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        String   @id @default(uuid()) // Maps to Supabase Auth User ID
  email     String   @unique
  username  String?  @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Future relationship hooks for game statistics and forum activity go here
}